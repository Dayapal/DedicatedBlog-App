# Server Configuration
PORT=4001
NODE_ENV=development

# Frontend Client URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/blog-app?retryWrites=true&w=majority

# Authentication
JWT_SECRET_KEY=your_jwt_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Media Storage
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_SECRET_KEY=your_cloudinary_secret_key

# Email Service (Resend)
RESEND_API_KEY=your_resend_api_key
CONTACT_RECEIVER_EMAIL=your_inbox@example.com
